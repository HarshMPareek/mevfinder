#!/bin/sh
# Multi-chain arbitrage classifier launcher.  ./arb -c ethereum scan 26149000   |   ./arb chains   |   ./arb -c bsc sample
set -eu
ARB_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ARB_ROOT"
if [ -x .venv/bin/python ]; then
    exec .venv/bin/python -m arbkit "$@"
fi
if command -v uv >/dev/null 2>&1; then
    exec uv run python -m arbkit "$@"
fi
echo 'Run: python3 -m venv .venv && .venv/bin/pip install -e .'
exit 1
